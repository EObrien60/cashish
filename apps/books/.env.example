# Postgres. Local dev/test: a plain container. Production: Neon's POOLED endpoint.
DATABASE_URL=postgres://cashish:cashish@127.0.0.1:5470/cashish_dev

# Session cookie signing key. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Vercel Blob, for receipt attachments. Unset locally = receipts fall back to
# ./data/blobs on disk (see src/lib/storage.ts).
BLOB_READ_WRITE_TOKEN=

# Public origin, used for OAuth redirect_uri validation and invite links.
APP_URL=http://localhost:3000
